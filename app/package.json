{
  "name": "lyra-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Lyra — native-feeling Jira-style project management for humans and CLI coding agents, by Ambient.",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "npm run build:electron && electron dist-electron/electron/main.js",
    "build:renderer": "tsc -p tsconfig.json && vite build",
    "build:preload": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/electron/preload.cjs",
    "build:electron": "tsc -p electron/tsconfig.json && npm run build:preload",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "vitest run",
    "package": "npm run build && electron-builder --mac"
  },
  "build": {
    "appId": "dev.ambient.lyra",
    "productName": "Lyra",
    "asar": true,
    "files": ["dist-electron/**/*", "dist/renderer/**/*", "package.json"],
    "extraResources": [],
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dir",
      "identity": null,
      "hardenedRuntime": false
    },
    "asarUnpack": ["**/*.node"]
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.5.2",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-table": "^8.20.6",
    "@tanstack/react-virtual": "^3.13.0",
    "better-sqlite3": "^11.9.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  }
}
